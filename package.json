{
  "name": "@lim324/dsh-session-manager",
  "version": "0.4.0",
  "description": "Full session management for the DSH web UI: delete (with trash/restore/purge), restore archived sessions, activity stats, continue/pause, fork to a new chat, unread markers, and open log folders. Plus a global context compaction threshold. No harness changes.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-scope": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-storage": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "js-yaml": "^4.3.1",
    "react": "^18.2.0",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-session-title": ">=0.1.5-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "license": "MIT"
}
